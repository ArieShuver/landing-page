---
---
<section id="hero" class="hero">
        <canvas id="particles-canvas" class="particles-canvas"></canvas>
        <div class="hero-gradient-orbs">
            <div class="orb orb-1"></div>
            <div class="orb orb-2"></div>
            <div class="orb orb-3"></div>
        </div>
        <div class="hero-grid-bg"></div>
        <div class="hero-content">
            <div class="hero-badge reveal-up">
                <span class="badge-dot"></span>
                <span>מומחים בבניית אתרים, SEO ופרסום ממומן</span>
            </div>
            <h1 class="hero-title">
                <span class="title-line reveal-up" style="--delay: 0.1s">הופכים חזון</span>
                <span class="title-line reveal-up" style="--delay: 0.2s">לנוכחות <span class="gradient-text"
                        id="glitch-title" data-text="דיגיטלית">דיגיטלית</span></span>
                <span class="title-line reveal-up" style="--delay: 0.3s">מנצחת</span>
            </h1>
            <div class="hero-typing reveal-up" style="--delay: 0.4s">
                <span class="typing-label">אנחנו מתמחים ב</span>
                <span class="typing-text" id="typing-text"></span>
                <span class="typing-cursor">|</span>
            </div>
            <p class="hero-desc reveal-up" style="--delay: 0.5s">
                <strong>סוכנות דיגיטל פרו</strong> מתמחה בבניית אתרים מקצועיים, <strong>קידום אתרים אורגני
                    (SEO)</strong> שמבטיח נוכחות איתנה בעמוד הראשון בגוגל, וניהול קמפיינים ממומנים עם החזר השקעה (ROI)
                יוצא דופן. הפתרון המושלם לצמיחת העסק שלך.
            </p>
            <div class="hero-buttons reveal-up" style="--delay: 0.6s">
                <a href="#contact" class="btn btn-primary magnetic-btn" id="hero-cta-primary">
                    <span class="btn-text">התחילו עכשיו</span>
                    <span class="btn-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="btn-shine"></span>
                </a>
                <a href="#portfolio" class="btn btn-secondary magnetic-btn" id="hero-cta-secondary">
                    <span class="btn-text">צפו בעבודות</span>
                    <span class="btn-icon">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M10 4V16M10 16L5 11M10 16L15 11" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                </a>
            </div>
            <div class="hero-stats reveal-up" style="--delay: 0.7s">
                <div class="hero-stat">
                    <span class="hero-stat-number">85+</span>
                    <span class="hero-stat-label">פרויקטים</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">50+</span>
                    <span class="hero-stat-label">לקוחות</span>
                </div>
                <div class="hero-stat-divider"></div>
                <div class="hero-stat">
                    <span class="hero-stat-number">4+</span>
                    <span class="hero-stat-label">שנות ניסיון</span>
                </div>
            </div>
        </div>
        <div class="hero-scroll-indicator reveal-up" style="--delay: 0.9s">
            <div class="scroll-mouse">
                <div class="scroll-wheel"></div>
            </div>
            <span>גלו איך אנחנו מביאים תוצאות</span>
        </div>
    </section>border-radius: 4px;
        transform-origin: top center;
        transform: rotateX(85deg) translateY(-2px);
        position: absolute;
        bottom: 0;
        border: 1px solid #333;
        box-shadow: 0 50px 50px rgba(0,0,0,0.8);
    }

    .lp-keyboard {
        position: absolute;
        top: 20px; left: 5%; right: 5%;
        height: 120px;
        background: #151515;
        border-radius: 4px;
        border: 1px solid #0f0f0f;
    }

    .lp-trackpad {
        position: absolute;
        bottom: 20px; left: 50%;
        transform: translateX(-50%);
        width: 100px; height: 60px;
        background: #222;
        border-radius: 4px;
        border: 1px solid #1a1a1a;
    }

    .lp-bottom-lip {
        position: absolute;
        bottom: -4px; left: 0; right: 0;
        height: 4px;
        background: #888;
        border-radius: 0 0 12px 12px;
        transform-origin: top center;
        transform: rotateX(90deg);
    }


    /* ======== ORBITING SCREENS & CARDS ======== */
    .screens-container {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        transform-style: preserve-3d;
        pointer-events: none; /* Let clicks pass through to hero buttons */
    }

    /* Common Glass styling for all floating elements */
    .glass-screen, .glass-card, .data-widget {
        position: absolute;
        background: rgba(16, 36, 43, 0.4);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border: 1px solid rgba(64,224,208,0.3);
        border-radius: 8px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.5), inset 0 0 20px rgba(255,255,255,0.05);
        transform-style: preserve-3d;
        overflow: hidden;
    }

    .glass-img {
        width: 100%; height: 100%;
        object-fit: cover;
        opacity: 0.85;
        mix-blend-mode: hard-light;
    }

    .glass-shine {
        position: absolute;
        top: 0; left: -100%;
        width: 50%; height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
        transform: skewX(-20deg);
        animation: shine 6s infinite;
    }

    @keyframes shine {
        0%, 80% { left: -100%; }
        100% { left: 200%; }
    }

    /* Positioning the screens (Counter-rotating the X axis so they stand up from the platform) */
    
    .g-left-large {
        width: 320px; height: 220px;
        top: 30%; left: 10%;
        /* Rotate X back up by -60 to stand upright, then rotate Y to face center */
        transform: rotateX(-60deg) rotateY(25deg) translateZ(100px);
    }

    .g-right-large {
        width: 320px; height: 220px;
        top: 30%; right: 10%;
        transform: rotateX(-60deg) rotateY(-25deg) translateZ(100px);
    }

    /* Small inner cards positioned in a circle around laptop */
    .glass-card {
        width: 140px; height: 80px;
        top: 50%; left: 50%;
        transform-origin: center center;
    }

    /* We translate them outwards in X/Z, and rotate them to face the camera/laptop */
    .gc-1 { transform: translate(-280px, -150px) rotateX(-60deg) rotateY(15deg); }
    .gc-2 { transform: translate(-350px, 0px) rotateX(-60deg) rotateY(35deg); }
    .gc-3 { transform: translate(-250px, 150px) rotateX(-60deg) rotateY(10deg); }
    
    .gc-4 { transform: translate(140px, -150px) rotateX(-60deg) rotateY(-15deg); }
    .gc-5 { transform: translate(210px, 0px) rotateX(-60deg) rotateY(-35deg); }
    .gc-6 { transform: translate(110px, 150px) rotateX(-60deg) rotateY(-10deg); }


    /* Floating data widgets */
    .data-widget {
        padding: 10px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        border-color: rgba(212,175,55,0.4);
    }

    .dw-1 {
        width: 120px; height: 60px;
        bottom: 20%; left: 20%;
        transform: rotateX(-60deg) rotateY(10deg) translateZ(50px);
        gap: 6px;
    }

    .dw-bar { height: 6px; border-radius: 3px; }

    .dw-2 {
        width: 80px; height: 80px;
        top: 25%; right: 25%;
        transform: rotateX(-60deg) rotateY(-15deg) translateZ(120px);
        align-items: center;
    }
    
    .dw-circle {
        width: 50px; height: 50px;
        border-radius: 50%;
        border: 3px solid #40E0D0;
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-weight: bold; font-size: 14px;
        box-shadow: 0 0 15px rgba(64,224,208,0.4);
    }

    .dw-3 {
        width: 140px; height: 40px;
        bottom: 30%; right: 20%;
        transform: rotateX(-60deg) translateZ(80px);
        align-items: center;
    }

    .dw-text {
        color: #D4AF37;
        font-weight: bold;
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* ======== ANIMATION / BREATHING ======== */
    .screens-container {
        animation: float-scene 8s ease-in-out infinite alternate;
    }

    @keyframes float-scene {
        0% { transform: translateY(0px); }
        100% { transform: translateY(-15px); }
    }

    /* ======== MOBILE SIMPLIFICATION ======== */
    @media (max-width: 768px) {
        .hero-replica {
            padding-top: 100px;
        }
        
        .scene-replica-wrapper {
            height: 400px;
            perspective: 800px;
        }
        
        .scene-replica {
            transform: rotateX(60deg) scale(0.45) translateY(-50px);
        }
        
        /* Hide complex elements on mobile to save performance */
        .glass-screen, .data-widget {
            display: none;
        }
    }
</style>