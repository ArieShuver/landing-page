                <div class="footer-links-col reveal-up" style="--delay: 0.2s">
                    <h4>שירותים</h4>
                    <ul>
                        <li><a href="#services">בניית אתרים</a></li>
                        <li><a href="#services">קידום אורגני SEO</a></li>
                        <li><a href="#services">פרסום ממומן PPC</a></li>
                        <li><a href="#services">חבילות משולבות</a></li>
                    </ul>
                </div>
                <div class="footer-links-col reveal-up" style="--delay: 0.3s">
                    <h4>החברה</h4>
                    <ul>
                        <li><a href="#hero">אודות</a></li>
                        <li><a href="#portfolio">פרויקטים</a></li>
                        <li><a href="#testimonials">המלצות</a></li>
                        <li><a href="#contact">צור קשר</a></li>
                    </ul>
                </div>
                <div class="footer-links-col reveal-up" style="--delay: 0.4s">
