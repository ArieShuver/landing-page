        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand reveal-up" style="--delay: 0.1s">
                    <a href="#hero" class="nav-logo">
                        <span class="logo-icon">
                            <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                                <defs>
                                    <linearGradient id="logoGrad2" x1="0%" y1="0%" x2="100%" y2="100%">
                                        <stop offset="0%" style="stop-color:#6366f1" />
                                        <stop offset="100%" style="stop-color:#06b6d4" />
                                    </linearGradient>
                                </defs>
                                <path d="M18 2L32 10V26L18 34L4 26V10L18 2Z" stroke="url(#logoGrad2)" stroke-width="2"
                                    fill="none" />
                                <path d="M18 8L26 12.5V21.5L18 26L10 21.5V12.5L18 8Z" fill="url(#logoGrad2)"
                                    opacity="0.3" />
                                <text x="18" y="21" text-anchor="middle" fill="url(#logoGrad2)" font-size="12"
                                    font-weight="800" font-family="Heebo">DP</text>
