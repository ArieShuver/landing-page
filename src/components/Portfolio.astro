<section id="portfolio" class="portfolio section">
    <div class="container">
        <div class="section-header">
            <span class="section-tag reveal-up">העבודות שלנו</span>
            <h2 class="section-title reveal-up">פרויקטים <span class="gradient-text">שמדברים בעד עצמם</span></h2>
            <p class="section-desc reveal-up text-reveal-scroll">הנה כמה מהפרויקטים האחרונים שלנו שמדגימים את היכולות והמומחיות שלנו</p>
        </div>
        
        <div class="portfolio-showcase">
            <!-- Project 1 (iPhone with image swap) -->
            <div class="showcase-item reveal-up">
                <div class="showcase-content">
                    <span class="portfolio-category">אתר תדמית וקידום</span>
                    <h3 class="portfolio-title">מרפאת שיניים - תותבות עד הבית</h3>
                    <p class="portfolio-desc">אפיון ועיצוב אתר תדמית מתקדם (Tutavot Ad Habait), בניית אזור מאמרים מקצועי (בלוג SEO) ומערך המרות לאיסוף לידים.</p>
                    <div class="portfolio-tech">
                        <span>UI/UX</span>
                        <span>WordPress</span>
                        <span>SEO</span>
                    </div>
                </div>
                <div class="showcase-mockup-wrapper">
                    <div class="iphone-mockup">
                        <div class="iphone-screen">
                            <div class="iphone-notch">
                                <div class="iphone-camera"></div>
                            </div>
                            <div class="iphone-display image-swap-container">
                                <img src="/images/media_1789645730740.png" alt="Tutavot 1" class="img-default" />
                                <img src="/images/media_1789645732912.png" alt="Tutavot 2" class="img-hover" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project 2: Law Firm (MacBook with scroll, Reversed) -->
            <div class="showcase-item showcase-item-reversed reveal-up" style="--delay: 0.2s">
                <div class="showcase-content">
                    <span class="portfolio-category">אתר תדמית</span>
                    <h3 class="portfolio-title">משרד עורכי דין</h3>
                    <p class="portfolio-desc">אתר תדמיתי יוקרתי עם מערכת זימון תורים ובלוג מקצועי</p>
                    <div class="portfolio-tech">
                        <span>WordPress</span>
                        <span>PHP</span>
                        <span>MySQL</span>
                    </div>
                </div>
                <div class="showcase-mockup-wrapper">
                    <div class="macbook-mockup">
                        <div class="macbook-screen">
                            <div class="macbook-camera"></div>
                            <div class="macbook-display">
                                <img src="/images/portfolio-5.png" alt="Law Firm" class="img-scroll" />
                            </div>
                        </div>
                        <div class="macbook-base">
                            <div class="macbook-notch"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project 3: Menahem Cohen (iPhone with image swap) -->
            <div class="showcase-item reveal-up" style="--delay: 0.3s">
                <div class="showcase-content">
                    <span class="portfolio-category">אתר תדמית ומיתוג</span>
                    <h3 class="portfolio-title">מנחם כהן - ביטוח ופיננסים</h3>
                    <p class="portfolio-desc">עיצוב ובניית אתר אישי מקצועי לסוכן ביטוח, כולל אינטגרציה של מחשבונים פיננסיים ויצירת משפך המרות חכם.</p>
                    <div class="portfolio-tech">
                        <span>WordPress</span>
                        <span>JavaScript</span>
                        <span>Conversion</span>
                    </div>
                </div>
                <div class="showcase-mockup-wrapper">
                    <div class="iphone-mockup">
                        <div class="iphone-screen">
                            <div class="iphone-notch">
                                <div class="iphone-camera"></div>
                            </div>
                            <div class="iphone-display image-swap-container">
                                <img src="/images/media_1789647402042.png" alt="Menahem 1" class="img-default" />
                                <img src="/images/media_1789645608574.png" alt="Menahem 2" class="img-hover" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Project 4 (MacBook with scroll, Reversed) -->
            <div class="showcase-item showcase-item-reversed reveal-up" style="--delay: 0.4s">
                <div class="showcase-content">
                    <span class="portfolio-category">פורטל תוכן</span>
                    <h3 class="portfolio-title">מגזין דיגיטלי</h3>
                    <p class="portfolio-desc">פורטל חדשות ותוכן בעל ביצועים גבוהים עם מערכת המלצות חכמה ו-100K+ מבקרים חודשיים</p>
                    <div class="portfolio-tech">
                        <span>Next.js</span>
                        <span>Headless CMS</span>
                        <span>CDN</span>
                    </div>
                </div>
                <div class="showcase-mockup-wrapper">
                    <div class="macbook-mockup">
                        <div class="macbook-screen">
                            <div class="macbook-camera"></div>
                            <div class="macbook-display">
                                <img src="/images/portfolio-6.png" alt="Digital Magazine" class="img-scroll" />
                            </div>
                        </div>
                        <div class="macbook-base">
                            <div class="macbook-notch"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
/* =====================================================================
   Portfolio Showcase Styles (Scoped)
   ===================================================================== */

.portfolio-showcase {
    display: flex;
    flex-direction: column;
    gap: 100px;
    margin-top: 50px;
}

.showcase-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.showcase-item-reversed {
    flex-direction: row-reverse;
}

.showcase-content {
    flex: 0 0 40%;
    padding: 20px;
}

.portfolio-category {
    display: inline-block;
    padding: 6px 12px;
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-primary-light);
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 15px;
    border: 1px solid rgba(99, 102, 241, 0.2);
}

.portfolio-title {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 20px;
    color: white;
    line-height: 1.2;
}

.portfolio-desc {
    color: #94a3b8;
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 25px;
}

.portfolio-tech {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.portfolio-tech span {
    background: rgba(255, 255, 255, 0.05);
    padding: 6px 15px;
    border-radius: 20px;
    font-size: 0.9rem;
    color: #cbd5e1;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}

.showcase-item:hover .portfolio-tech span {
    border-color: rgba(99, 102, 241, 0.4);
    color: white;
    background: rgba(99, 102, 241, 0.1);
}

/* 3D Mockup Container */
.showcase-mockup-wrapper {
    flex: 0 0 55%;
    perspective: 2000px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

/* =========================================
   Realistic MacBook Mockup
   ========================================= */
.macbook-mockup {
    width: 100%;
    max-width: 600px;
    position: relative;
    transform: rotateY(-15deg) rotateX(5deg);
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

.showcase-item-reversed .macbook-mockup {
    transform: rotateY(15deg) rotateX(5deg);
}

.showcase-item:hover .macbook-mockup {
    transform: rotateY(0deg) rotateX(0deg) scale(1.05);
}

.macbook-screen {
    width: 100%;
    padding-bottom: 64%; /* 16:10 */
    background: #000;
    border: 2px solid #555; /* Metallic outer rim */
    border-radius: 12px 12px 0 0;
    position: relative;
    box-shadow: 
        inset 0 0 0 8px #111, /* Inner black bezel */
        0 10px 30px rgba(0,0,0,0.6);
    overflow: hidden;
}

/* Glass Reflection */
.macbook-screen::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(135deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 100%);
    pointer-events: none;
    z-index: 20;
}

.macbook-camera {
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    background: #222;
    border-radius: 50%;
    border: 1px solid #000;
    z-index: 10;
    box-shadow: inset 0 0 2px rgba(255,255,255,0.2);
}

.macbook-display {
    position: absolute;
    top: 18px; /* Inside bezel */
    left: 10px;
    right: 10px;
    bottom: 15px; /* Leave space for bottom bezel */
    background: #1a1a1a;
    overflow: hidden;
}

.macbook-display::after {
    content: 'MacBook Pro';
    position: absolute;
    bottom: -13px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 6px;
    color: #444;
    letter-spacing: 1px;
}

.macbook-base {
    width: 114%;
    height: 18px;
    background: linear-gradient(to bottom, #d4d4d4, #888); /* Silver metallic base */
    margin-left: -7%;
    border-radius: 2px 2px 12px 12px;
    position: relative;
    box-shadow: 
        inset 0 -3px 8px rgba(0,0,0,0.5), 
        0 20px 40px rgba(0,0,0,0.6);
}

.macbook-notch {
    width: 16%;
    height: 6px;
    background: #666;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    border-radius: 0 0 6px 6px;
    box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
}

/* =========================================
   Realistic iPhone Mockup
   ========================================= */
.iphone-mockup {
    width: 100%;
    max-width: 250px;
    position: relative;
    transform: rotateY(-15deg) rotateX(5deg);
    transform-style: preserve-3d;
    transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    margin: 0 auto;
    border-radius: 40px;
}

/* Phone Buttons */
.iphone-mockup::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 80px;
    width: 4px;
    height: 30px;
    background: #666;
    border-radius: 4px 0 0 4px;
    box-shadow: 0 50px 0 #666; /* Volume down */
}
.iphone-mockup::after {
    content: '';
    position: absolute;
    right: -4px;
    top: 100px;
    width: 4px;
    height: 45px;
    background: #666;
    border-radius: 0 4px 4px 0;
}

.showcase-item-reversed .iphone-mockup {
    transform: rotateY(15deg) rotateX(5deg);
}

.showcase-item:hover .iphone-mockup {
    transform: rotateY(0deg) rotateX(0deg) scale(1.05);
}

.iphone-screen {
    width: 100%;
    padding-bottom: 210%; /* 19.5:9 */
    background: #000;
    border: 3px solid #ccc;
    box-shadow: 
        inset 0 0 0 8px #111,
        0 0 0 1px #999,
        0 20px 50px rgba(0,0,0,0.6);
    border-radius: 40px;
    position: relative;
    overflow: hidden;
}

.iphone-screen::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100%;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0) 40%);
    pointer-events: none;
    z-index: 20;
}

.iphone-notch {
    position: absolute;
    top: 8px; /* Inside bezel */
    left: 50%;
    transform: translateX(-50%);
    width: 40%;
    height: 25px;
    background: #111;
    border-radius: 0 0 15px 15px;
    z-index: 10;
}

.iphone-camera {
    position: absolute;
    top: 8px;
    left: 70%;
    width: 10px;
    height: 10px;
    background: #000;
    border-radius: 50%;
    box-shadow: inset 0 0 4px rgba(255,255,255,0.3);
}

.iphone-display {
    position: absolute;
    top: 8px;
    left: 8px;
    right: 8px;
    bottom: 8px;
    background: #1a1a1a;
    border-radius: 32px; /* Matches inner bezel */
    overflow: hidden;
}

/* =========================================
   Image Display Logic (Swap & Scroll)
   ========================================= */

/* Scrolling for MacBooks */
.img-scroll {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 3s ease-out;
    transform-origin: top center;
}
.showcase-item:hover .img-scroll {
    transform: translateY(calc(-100% + 100% * 0.64)); 
}

/* Swap for iPhones */
.image-swap-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: opacity 0.5s ease;
}

.image-swap-container .img-hover {
    opacity: 0;
}

.showcase-item:hover .image-swap-container .img-default {
    opacity: 0;
}

.showcase-item:hover .image-swap-container .img-hover {
    opacity: 1;
}

/* Responsive */
@media (max-width: 992px) {
    .showcase-item, .showcase-item-reversed {
        flex-direction: column;
        text-align: center;
        gap: 30px;
    }

    .portfolio-tech {
        justify-content: center;
    }

    .macbook-mockup, .iphone-mockup {
        transform: rotateY(0) rotateX(0);
    }
    
    .showcase-item:hover .macbook-mockup,
    .showcase-item:hover .iphone-mockup {
        transform: scale(1.02);
    }
}
</style>