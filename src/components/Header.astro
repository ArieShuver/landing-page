---
<nav id="navbar" class="navbar">
        <div class="nav-container">
            <a href="#hero" class="nav-logo" id="nav-logo">
                <span class="logo-icon">
                    <svg width="36" height="36" viewBox="0 0 36 36" fill="none">
                        <defs>
                            <linearGradient id="logoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:#6366f1" />
                                <stop offset="100%" style="stop-color:#06b6d4" />
                            </linearGradient>
                        </defs>
                        <path d="M18 2L32 10V26L18 34L4 26V10L18 2Z" stroke="url(#logoGrad)" stroke-width="2"
                            fill="none" />
                        <path d="M18 8L26 12.5V21.5L18 26L10 21.5V12.5L18 8Z" fill="url(#logoGrad)" opacity="0.3" />
                        <text x="18" y="21" text-anchor="middle" fill="url(#logoGrad)" font-size="12" font-weight="800"
                            font-family="Heebo">DP</text>
                    </svg>
                </span>
                <span class="logo-text">Digital<span class="logo-highlight">Pro</span></span>
            </a>

            <ul class="nav-links" id="nav-links">
                <li><a href="#hero" class="nav-link active">בית</a></li>
                <li><a href="#services" class="nav-link">שירותים</a></li>
                <li><a href="#portfolio" class="nav-link">עבודות</a></li>
                <li><a href="#process" class="nav-link">תהליך</a></li>
                <li><a href="#testimonials" class="nav-link">המלצות</a></li>
                <li><a href="#contact" class="nav-link">צור קשר</a></li>
            </ul>

            <a href="#contact" class="nav-cta magnetic-btn" id="nav-cta">
                <span>בואו נדבר</span>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                        stroke-linejoin="round" />
                </svg>
            </a>

            <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu">
                <span class="toggle-bar"></span>
                <span class="toggle-bar"></span>
                <span class="toggle-bar"></span>
            </button>
        </div>
    </nav>