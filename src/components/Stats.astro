---
---
<section id="stats" class="stats section">
        <div class="stats-bg">
            <div class="stats-orb stats-orb-1"></div>
            <div class="stats-orb stats-orb-2"></div>
        </div>
        <div class="container">
            <div class="stats-grid">
                <div class="stat-card reveal-up" style="--delay: 0.1s">
                    <div class="stat-icon">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                            <path d="M3 21L10 14L15 19L25 7" stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M19 7H25V13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                    </div>
                    <span class="stat-number counter" data-target="85">0</span>
                    <span class="stat-suffix">+</span>
                    <span class="stat-label">פרויקטים שהושלמו</span>
                </div>
                <div class="stat-card reveal-up" style="--delay: 0.2s">
                    <div class="stat-icon">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                            <path d="M20 21V19C20 16.7909 18.2091 15 16 15H12C9.79086 15 8 16.7909 8 19V21"
                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                            <circle cx="14" cy="9" r="4" stroke="currentColor" stroke-width="2.5" />
                            <path d="M24 21V19C24 17.74 23.2 16.65 22.1 16.24" stroke="currentColor" stroke-width="2.5"
                                stroke-linecap="round" />
                            <path d="M19 3.24C20.11 3.64 20.87 4.74 20.87 6.01C20.87 7.28 20.11 8.37 19 8.78"
                                stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <span class="stat-number counter" data-target="50">0</span>
                    <span class="stat-suffix">+</span>
                    <span class="stat-label">לקוחות מרוצים</span>
                </div>
                <div class="stat-card reveal-up" style="--delay: 0.3s">
                    <div class="stat-icon">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                            <circle cx="14" cy="14" r="11" stroke="currentColor" stroke-width="2.5" />
                            <path d="M14 7V14L19 17" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                        </svg>
                    </div>
                    <span class="stat-number counter" data-target="4">0</span>
                    <span class="stat-suffix">+</span>
                    <span class="stat-label">שנות ניסיון</span>
                </div>
                <div class="stat-card reveal-up" style="--delay: 0.4s">
                    <div class="stat-icon">
                        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
                            <path
                                d="M14 3L17.09 9.26L24 10.27L19 15.14L20.18 22.02L14 18.77L7.82 22.02L9 15.14L4 10.27L10.91 9.26L14 3Z"
                                stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <span class="stat-number counter" data-target="99">0</span>
                    <span class="stat-suffix">%</span>
                    <span class="stat-label">שביעות רצון</span>
                </div>
            </div>
        </div>
    </section>