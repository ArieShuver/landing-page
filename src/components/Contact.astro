---
---
<section id="contact" class="contact section">
        <div class="container">
            <div class="section-header">
                <span class="section-tag reveal-up">צרו קשר</span>
                <h2 class="section-title reveal-up">בואו <span class="gradient-text">נדבר</span></h2>
                <p class="section-desc reveal-up text-reveal-scroll">השאירו פרטים ונחזור אליכם תוך שעות ספורות עם הצעה
                    מותאמת אישית</p>
            </div>
            <div class="contact-grid">
                <div class="contact-info reveal-up" style="--delay: 0.1s">
                    <div class="contact-info-card">
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M3 5.5C3 13.51 9.49 20 17.5 20C17.9 20 18.29 19.97 18.67 19.92C19.05 19.87 19.25 19.42 19.04 19.1L16.86 15.77C16.69 15.51 16.36 15.4 16.07 15.5L13.18 16.52C12.86 16.63 12.51 16.52 12.31 16.24L8.76 11.19C8.56 10.91 8.56 10.54 8.76 10.26L10.68 7.58C10.84 7.36 10.86 7.07 10.73 6.83L8.19 2.13C7.99 1.77 7.53 1.65 7.2 1.9C4.72 3.73 3 5.5 3 5.5Z"
                                        stroke="currentColor" stroke-width="1.5" />
                                </svg>
                            </div>
                            <div>
                                <h4>טלפון</h4>
                                <a href="tel:+972501234567">050-123-4567</a>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path d="M22 16.92V20C22 20.55 21.55 21 21 21C10.5 21 3 13.5 3 3C3 2.45 3.45 2 4 2H7.08C7.57 2 7.99 2.36 8.07 2.84C8.17 3.5 8.35 4.14 8.6 4.75C8.75 5.12 8.66 5.55 8.36 5.85L6.91 7.3C8.34 10.3 10.7 12.66 13.7 14.09L15.15 12.64C15.45 12.34 15.88 12.25 16.25 12.4C16.86 12.65 17.5 12.83 18.16 12.93C18.64 13.01 19 13.43 19 13.92V16.92Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </div>
                            <div>
                                <h4>טלפון / וואטסאפ</h4>
                                <a href="tel:0552640334" style="direction: ltr; display: inline-block;">055-264-0334</a>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor"
                                        stroke-width="1.5" />
                                    <path d="M3 7L12 13L21 7" stroke="currentColor" stroke-width="1.5"
                                        stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                            <div>
                                <h4>אימייל</h4>
                                <a href="mailto:info@digitalpro.co.il">info@digitalpro.co.il</a>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <path
                                        d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2Z"
                                        stroke="currentColor" stroke-width="1.5" />
                                    <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5" />
                                </svg>
                            </div>
                            <div>
                                <h4>כתובת</h4>
                                <span>רחוב הרצל 100, תל אביב</span>
                            </div>
                        </div>
                        <div class="contact-info-item">
                            <div class="contact-info-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5" />
                                    <path d="M12 6V12L16 14" stroke="currentColor" stroke-width="1.5"
                                        stroke-linecap="round" />
                                </svg>
                            </div>
                            <div>
                                <h4>שעות פעילות</h4>
                                <span>א'-ה' 9:00-18:00</span>
                            </div>
                        </div>
                    </div>
                    <div class="contact-social">
                        <a href="#" class="social-link" aria-label="Facebook">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path
                                    d="M18 10C18 5.58 14.42 2 10 2C5.58 2 2 5.58 2 10C2 14.05 4.93 17.4 8.75 17.93V12.44H6.72V10H8.75V8.17C8.75 6.16 9.94 5.07 11.77 5.07C12.65 5.07 13.56 5.23 13.56 5.23V7.22H12.56C11.56 7.22 11.25 7.83 11.25 8.46V10H13.47L13.11 12.44H11.25V17.93C15.07 17.4 18 14.05 18 10Z"
                                    fill="currentColor" />
                            </svg>
                        </a>
                        <a href="#" class="social-link" aria-label="Instagram">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <rect x="3" y="3" width="14" height="14" rx="4" stroke="currentColor"
                                    stroke-width="1.5" />
                                <circle cx="10" cy="10" r="3.5" stroke="currentColor" stroke-width="1.5" />
                                <circle cx="14.5" cy="5.5" r="1" fill="currentColor" />
                            </svg>
                        </a>
                        <a href="#" class="social-link" aria-label="LinkedIn">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <rect x="3" y="3" width="14" height="14" rx="2" stroke="currentColor"
                                    stroke-width="1.5" />
                                <path d="M7 9V13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                                <path d="M7 7V7.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                <path d="M10 13V10.5C10 9.67 10.67 9 11.5 9C12.33 9 13 9.67 13 10.5V13"
                                    stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                            </svg>
                        </a>
                        <a href="https://wa.me/972552640334" target="_blank" class="social-link" aria-label="WhatsApp">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path
                                    d="M17 10C17 13.87 13.87 17 10 17C8.8 17 7.67 16.7 6.68 16.17L3 17L3.83 13.32C3.3 12.33 3 11.2 3 10C3 6.13 6.13 3 10 3C13.87 3 17 6.13 17 10Z"
                                    stroke="currentColor" stroke-width="1.5" />
                                <path
                                    d="M7 9.5C7 9.5 7.5 11 9.25 12.75C11 14.5 12.5 15 12.5 15L14 13.5L12 12L11 13C11 13 9.5 12 8.5 11C7.5 10 7 8.5 7 8.5L8 7.5L6.5 5.5L5 7C5 7 5 8.5 7 9.5Z"
                                    fill="currentColor" opacity="0.6" />
                            </svg>
                        </a>
                    </div>
                </div>
                <form class="contact-form reveal-up" style="--delay: 0.2s" id="contact-form">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="name" class="form-label">שם מלא</label>
                            <input type="text" id="name" name="name" class="form-input" placeholder="הכניסו את השם שלכם"
                                required>
                            <div class="form-input-border"></div>
                        </div>
                        <div class="form-group">
                            <label for="phone" class="form-label">טלפון</label>
                            <input type="tel" id="phone" name="phone" class="form-input" placeholder="050-000-0000"
                                required>
                            <div class="form-input-border"></div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="email" class="form-label">אימייל</label>
                        <input type="email" id="email" name="email" class="form-input" placeholder="your@email.com"
                            required>
                        <div class="form-input-border"></div>
                    </div>
                    <div class="form-group">
                        <label for="service" class="form-label">שירות מבוקש</label>
                        <select id="service" name="service" class="form-input form-select" required>
                            <option value="" disabled selected>בחרו שירות</option>
                            <option value="web-dev">בניית אתר חדש</option>
                            <option value="web-redesign">שדרוג / עיצוב מחדש של אתר</option>
                            <option value="seo">קידום אורגני SEO</option>
                            <option value="ppc">פרסום ממומן PPC</option>
                            <option value="seo-ppc">חבילה משולבת SEO + PPC</option>
                            <option value="full">חבילה מלאה (אתר + קידום + פרסום)</option>
                            <option value="other">אחר</option>
                        </select>
                        <div class="form-input-border"></div>
                    </div>
                    <div class="form-group">
                        <label for="message" class="form-label">הודעה</label>
                        <textarea id="message" name="message" class="form-input form-textarea" rows="4"
                            placeholder="ספרו לנו קצת על הפרויקט שלכם..." required></textarea>
                        <div class="form-input-border"></div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-full magnetic-btn" id="contact-submit">
                        <span class="btn-text">שלחו הודעה</span>
                        <span class="btn-icon">
                            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                                <path d="M18 2L9 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                                <path d="M18 2L12 18L9 11L2 8L18 2Z" stroke="currentColor" stroke-width="2"
                                    stroke-linejoin="round" />
                            </svg>
                        </span>
                        <span class="btn-shine"></span>
                    </button>
                    <div class="form-success" id="form-success">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                            <circle cx="24" cy="24" r="20" stroke="#10b981" stroke-width="2" />
                            <path d="M16 24L22 30L32 18" stroke="#10b981" stroke-width="3" stroke-linecap="round"
                                stroke-linejoin="round" />
                        </svg>
                        <h3>ההודעה נשלחה בהצלחה!</h3>
                        <p>נחזור אליכם בהקדם. תודה רבה!</p>
                    </div>
                </form>
            </div>
        </div>
    </section>